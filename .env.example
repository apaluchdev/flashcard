# Copy to .env and fill in. `docker compose` also reads .env for the app container.

# Database (matches the defaults in compose.yaml). Used by `npm run dev` and drizzle-kit on the host.
DATABASE_URL=postgres://flashcard:flashcard@localhost:5432/flashcard

# Better Auth: any random string of 32+ characters, e.g. from `openssl rand -base64 32`.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# OAuth apps (see docs/PLAN.md, Phase 1).
# GitHub callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Google redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
